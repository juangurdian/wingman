{
  "name": "wingman-mcp",
  "version": "0.1.0",
  "description": "Your coding agent's wingman — TypeScript MCP bridge + pair CLI so Grok Bot (and other MCP hosts) can talk to live Codex and Claude Code sessions on your machine",
  "type": "module",
  "main": "dist/mcp/server.js",
  "bin": {
    "wingman-pair": "./dist/pair.js",
    "wingman-doctor": "./dist/doctor.js",
    "wingman-tunnel": "./dist/tunnel.js",
    "wingman-mcp": "./dist/pair.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/mcp/server.ts",
    "pair": "tsx src/pair.ts",
    "doctor": "tsx src/doctor.ts",
    "tunnel": "tsx src/tunnel.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "wingman",
    "codex",
    "grok",
    "openai-codex",
    "claude-code",
    "mcp-server",
    "pair-programming",
    "open-source"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.280",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/juangurdian/wingman.git"
  },
  "bugs": {
    "url": "https://github.com/juangurdian/wingman/issues"
  },
  "homepage": "https://github.com/juangurdian/wingman#readme",
  "author": "Juan Gurdian and contributors"
}
